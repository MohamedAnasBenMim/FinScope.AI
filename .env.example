# Docker works with defaults; copy to .env only to customize.
APP_NAME=FinScope.AI
APP_VERSION=1.0.0
ENV=development
# DATABASE_URL, storage directories and service URLs are set inside Compose.
# For a host-run backend, these defaults work with the published service ports.
DATABASE_URL=sqlite:///./data/finscope.db
UPLOAD_DIR=./data/uploads
MODEL_CACHE_DIR=./data/models
WORKER_HEARTBEAT_PATH=./data/worker.heartbeat
CORS_ORIGINS=["http://localhost:5173","http://localhost:8081"]
MAX_FILE_SIZE=31457280
MAX_FILES_PER_UPLOAD=20
MAX_DOCUMENT_PAGES=500
MAX_SPREADSHEET_CELLS=200000
MAX_IMAGE_PIXELS=40000000
MAX_ARCHIVE_BYTES=209715200
DUPLICATE_BEHAVIOR=reuse
CLASSIFICATION_THRESHOLD=0.65
PARSER_PROVIDER=native
OCR_PROVIDER=tesseract
OCR_LANGUAGES=fra+eng
OCR_MIN_TEXT_CHARS=30
OCR_TIMEOUT=90
INGESTION_TIMEOUT=1200
WORKER_POLL_INTERVAL=1
CHUNK_WORDS=260
TABLE_CHUNK_ROWS=20
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=finscope_multilingual_v1
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSIONS=384
EMBEDDING_THREADS=2
EMBEDDING_LOCAL_ONLY=false
HF_HUB_DISABLE_XET=1
LLM_PROVIDER=local
LLM_MODEL=finscope-local
# Leave unset for Docker: Compose uses http://llm:8080/v1.
# For a host-run backend: LLM_BASE_URL=http://localhost:8082/v1
# For OpenAI: LLM_PROVIDER=openai, choose LLM_MODEL, set LLM_BASE_URL=https://api.openai.com/v1
# For Ollama: LLM_PROVIDER=ollama, LLM_BASE_URL=http://ollama:11434, LLM_MODEL=qwen2.5:1.5b
LLM_API_KEY=
PROVIDER_TIMEOUT=180
RETRIEVAL_TOP_K=24
RERANK_TOP_K=10
MIN_RETRIEVAL_SCORE=0.05
RERANK_ENABLED=true
RETRIEVAL_DEBUG=false
BACKEND_PORT=8001
FRONTEND_PORT=8081
QDRANT_PORT=6333
LLM_PORT=8082
# Development-only Postgres default; set a unique password for your own installation.
# POSTGRES_PASSWORD=
# Optional Ollama profile model:
OLLAMA_MODEL=qwen2.5:1.5b
# Frontend host builds only (Vite normally proxies /api):
# VITE_API_URL=/api
